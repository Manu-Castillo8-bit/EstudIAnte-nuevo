<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstudIAnte.InicioView">
    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="16">
            <Label Text="Inicio" FontSize="28" FontAttributes="Bold" TextColor="#E8ECFF" />
            <Label Text="Bienvenido a EstudIAnte" FontSize="15" TextColor="#8B95C9" />

            <Border BackgroundColor="#131B3F" Stroke="#1E2A5A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🎓  Tu asistente de estudio" FontSize="18" FontAttributes="Bold" TextColor="#E8ECFF" />
                    <Label Text="Chatea con la IA, crea cuestionarios y organiza tus documentos en un solo lugar."
                           TextColor="#8B95C9" />
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="#131B3F" Stroke="#1E2A5A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="18">
                <VerticalStackLayout Spacing="8">
                    <Label Text="📈  Progreso" FontSize="18" FontAttributes="Bold" TextColor="#E8ECFF" />
                    <Label Text="Aún no tienes actividad registrada." TextColor="#8B95C9" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
