<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstudIAnte.LoginWindow"
             Title="Login"
             BackgroundColor="#0B1026">
    <Grid Padding="24">
        <VerticalStackLayout x:Name="Root" Spacing="14" WidthRequest="340"
                             HorizontalOptions="Center" VerticalOptions="Center">
            <Label Text="🎓" FontSize="48" HorizontalOptions="Center" />
            <Label FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" TextColor="#E8ECFF">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Estud" />
                        <Span Text="IA" TextColor="#22D3EE" />
                        <Span Text="nte" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>
            <Label Text="Inicia sesión para continuar" TextColor="#8B95C9" HorizontalOptions="Center" />

            <Entry x:Name="Usuario" Placeholder="Usuario" BackgroundColor="#131B3F"
                   TextColor="#E8ECFF" PlaceholderColor="#8B95C9" Margin="0,10,0,0" />
            <Entry x:Name="Clave" Placeholder="Contraseña" IsPassword="True" BackgroundColor="#131B3F"
                   TextColor="#E8ECFF" PlaceholderColor="#8B95C9" />

            <Button Text="Iniciar sesión" BackgroundColor="#22D3EE" TextColor="#0B1026"
                    Clicked="Login_Click" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
