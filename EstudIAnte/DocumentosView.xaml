<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstudIAnte.DocumentosView">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Documentos" FontSize="28" FontAttributes="Bold" TextColor="#E8ECFF" />

            <Border BackgroundColor="#131B3F" Stroke="#1E2A5A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="14">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="📄" FontSize="24" VerticalOptions="Center" />
                    <VerticalStackLayout>
                        <Label Text="Resumen Revolución Industrial.pdf" TextColor="#E8ECFF" />
                        <Label Text="120 KB" FontSize="11" TextColor="#8B95C9" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Border BackgroundColor="#131B3F" Stroke="#1E2A5A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="14">
                <HorizontalStackLayout Spacing="12">
                    <Label Text="📄" FontSize="24" VerticalOptions="Center" />
                    <VerticalStackLayout>
                        <Label Text="Apuntes de Historia.docx" TextColor="#E8ECFF" />
                        <Label Text="85 KB" FontSize="11" TextColor="#8B95C9" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <Button Text="Subir documento" BackgroundColor="#22D3EE" TextColor="#0B1026" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
