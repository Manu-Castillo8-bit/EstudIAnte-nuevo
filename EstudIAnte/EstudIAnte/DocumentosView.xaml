<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:controls="clr-namespace:EstudIAnte.Controls"
             x:Class="EstudIAnte.DocumentosView">
    <Grid>
        <ScrollView>
            <VerticalStackLayout Padding="28,8,28,28" Spacing="16">

            <!-- Encabezado -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Border WidthRequest="54" HeightRequest="54" Background="{StaticResource CardPink}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16">
                <Label Text="📁" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Documentos" Style="{StaticResource PageTitle}" />
                    <Label Text="Sube archivos y obtén respuestas desde ellos" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <controls:PulsarButton x:Name="BtnSubir" Grid.Column="2" Text="＋  Subir documento"
                        Style="{StaticResource PrimaryButton}" Clicked="Subir_Click" />
            </Grid>

            <!-- Zona de carga -->
            <Border Stroke="{StaticResource Violet}" StrokeThickness="1.5" StrokeDashArray="5,4"
                    BackgroundColor="#0D1236" StrokeShape="RoundRectangle 18" Padding="30">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ZonaCarga_Tapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False"
                                       Color="{StaticResource Cyan}" HorizontalOptions="Center" />
                    <Label x:Name="IconoNube" Text="☁" FontSize="40" HorizontalOptions="Center"
                           TextColor="{StaticResource Cyan}" />
                    <Label Text="Toca aquí o usa 'Subir documento'" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}" HorizontalOptions="Center" />
                    <Label Text="PDF · DOCX · TXT · XLSX · CSV · PPTX · MD · LOG · máx. 20 MB" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <SearchBar x:Name="Buscador" Placeholder="🔍   Buscar por nombre o contenido..."
                       BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                       PlaceholderColor="{StaticResource TextMuted}" Margin="0,4,0,0"
                       TextChanged="Buscador_TextChanged" />

            <Label Text="Archivos recientes" FontSize="15" FontAttributes="Bold"
                   TextColor="{StaticResource TextMain}" Margin="0,6,0,0" />

            <CollectionView x:Name="ListaDocumentos">
                <CollectionView.EmptyView>
                    <Label Text="Todavía no has subido documentos." Style="{StaticResource Muted}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
                                <Grid Grid.Row="0" ColumnDefinitions="Auto,*" ColumnSpacing="16">
                                    <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{Binding ColorFondo}"
                                            Stroke="{Binding ColorTexto}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                        <Label Text="{Binding TipoEtiqueta}" FontSize="12" FontAttributes="Bold"
                                               TextColor="{Binding ColorTexto}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                        <Label Text="{Binding Nombre}" FontAttributes="Bold"
                                               TextColor="{StaticResource TextMain}" />
                                        <Label FontSize="12" TextColor="{StaticResource TextMuted}">
                                            <Label.FormattedText>
                                                <FormattedString>
                                                    <Span Text="{Binding TamanoTexto}" />
                                                    <Span Text="  ·  " />
                                                    <Span Text="{Binding Estado}" />
                                                </FormattedString>
                                            </Label.FormattedText>
                                        </Label>
                                        <Label Text="{Binding Resumen}" FontSize="12" TextColor="{StaticResource Cyan}"
                                               IsVisible="{Binding TieneResumen}" />
                                    </VerticalStackLayout>
                                </Grid>
                                <!-- Botones: se acomodan en una o varias líneas según el ancho -->
                                <FlexLayout Grid.Row="1" Wrap="Wrap" JustifyContent="End"
                                            AlignItems="Center" AlignContent="Start">
                                    <controls:PulsarButton Text="👁  Ver contenido" Style="{StaticResource GhostButton}"
                                            HeightRequest="40" Clicked="Ver_Click" Margin="0,0,8,4"
                                            IsVisible="{Binding PuedeVer}"
                                            CommandParameter="{Binding Id}" />
                                    <controls:PulsarButton Text="{Binding TextoBotonAnalizar}" Style="{StaticResource GhostButton}"
                                            HeightRequest="40" Clicked="Analizar_Click" Margin="0,0,8,4"
                                            IsEnabled="{Binding PuedeAnalizar}"
                                            CommandParameter="{Binding Id}" />
                                    <controls:PulsarButton Text="Crear cuestionario" Style="{StaticResource GhostButton}"
                                            HeightRequest="38" Clicked="CrearCuestionario_Click" Margin="0,0,8,4"
                                            IsVisible="{Binding Listo}"
                                            CommandParameter="{Binding Id}" />
                                    <controls:PulsarButton Text="🔀  Generar diagrama" Style="{StaticResource GhostButton}"
                                            HeightRequest="38" Clicked="CrearDiagrama_Click" Margin="0,0,8,4"
                                            IsVisible="{Binding Listo}"
                                            CommandParameter="{Binding Id}" />
                                    <controls:PulsarButton Text="🗑  Eliminar" Style="{StaticResource GhostButton}"
                                            HeightRequest="38" TextColor="{StaticResource Pink}" Margin="0,0,8,4"
                                            Clicked="Eliminar_Click" CommandParameter="{Binding Id}" />
                                </FlexLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
        </ScrollView>

        <!-- ===== VISOR DE CONTENIDO (overlay) ===== -->
        <Border x:Name="PanelVisor" IsVisible="False" BackgroundColor="{StaticResource Bg}"
                HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">
            <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12" Padding="24,18,24,18">
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="2">
                        <Label x:Name="TituloVisor" Text="Documento" FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" />
                        <Label x:Name="MetaVisor" Text="" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                    <controls:PulsarButton x:Name="BtnCerrarVisor" Grid.Column="1" Text="✕  Cerrar"
                            Style="{StaticResource GhostButton}" Clicked="CerrarVisor_Click" />
                </Grid>

                <ScrollView Grid.Row="2">
                    <Label x:Name="TextoVisor" Text="" TextColor="{StaticResource TextMain}" LineBreakMode="WordWrap" />
                </ScrollView>

                <HorizontalStackLayout Grid.Row="3" Spacing="8">
                    <controls:PulsarButton x:Name="BtnVisorResumen" Text="📝  Resumen con IA"
                            Style="{StaticResource PrimaryButton}" Clicked="VisorResumen_Click" />
                    <controls:PulsarButton Text="📋  Cuestionario" Style="{StaticResource GhostButton}"
                            Clicked="VisorCuestionario_Click" />
                    <controls:PulsarButton Text="🔀  Diagrama" Style="{StaticResource GhostButton}"
                            Clicked="VisorDiagrama_Click" />
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>
