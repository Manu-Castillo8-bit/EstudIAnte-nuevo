<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstudIAnte.DocumentosView">
    <ScrollView>
        <VerticalStackLayout Padding="28,8,28,28" Spacing="16">

            <!-- Encabezado -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Border WidthRequest="54" HeightRequest="54" Background="{StaticResource CardPink}"
                        StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Label Text="📁" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Documentos" Style="{StaticResource PageTitle}" />
                    <Label Text="Sube archivos y obtén respuestas desde ellos" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
                <Button x:Name="BtnSubir" Grid.Column="2" Text="＋  Subir documento"
                        Style="{StaticResource PrimaryButton}" Clicked="Subir_Click" />
            </Grid>

            <!-- Zona de carga -->
            <Border Stroke="{StaticResource Violet}" StrokeThickness="1.5" StrokeDashArray="5,4"
                    BackgroundColor="#0D1236" StrokeShape="RoundRectangle 18" Padding="30">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="ZonaCarga_Tapped" />
                </Border.GestureRecognizers>
                <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                    <ActivityIndicator x:Name="Spinner" IsRunning="False" IsVisible="False"
                                       Color="{StaticResource Cyan}" HorizontalOptions="Center" />
                    <Label x:Name="IconoNube" Text="☁" FontSize="40" HorizontalOptions="Center"
                           TextColor="{StaticResource Cyan}" />
                    <Label Text="Toca aquí o usa 'Subir documento'" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource TextMain}" HorizontalOptions="Center" />
                    <Label Text="PDF, DOCX, TXT · máx. 20 MB" Style="{StaticResource Muted}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Archivos recientes" FontSize="15" FontAttributes="Bold"
                   TextColor="{StaticResource TextMain}" Margin="0,6,0,0" />

            <CollectionView x:Name="ListaDocumentos">
                <CollectionView.EmptyView>
                    <Label Text="Todavía no has subido documentos." Style="{StaticResource Muted}" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,10">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                                <Border WidthRequest="48" HeightRequest="48" BackgroundColor="{Binding ColorFondo}"
                                        Stroke="{Binding ColorTexto}" StrokeThickness="1" StrokeShape="RoundRectangle 12">
                                    <Label Text="{Binding TipoEtiqueta}" FontSize="12" FontAttributes="Bold"
                                           TextColor="{Binding ColorTexto}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Nombre}" FontAttributes="Bold"
                                           TextColor="{StaticResource TextMain}" />
                                    <Label FontSize="12" TextColor="{StaticResource TextMuted}">
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding TamanoTexto}" />
                                                <Span Text="  ·  " />
                                                <Span Text="{Binding Estado}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <Label Text="{Binding Resumen}" FontSize="12" TextColor="{StaticResource Cyan}"
                                           IsVisible="{Binding TieneResumen}" MaximumWidthRequest="520" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Column="2" Spacing="6">
                                    <Button Text="{Binding TextoBotonAnalizar}" Style="{StaticResource GhostButton}"
                                            HeightRequest="40" Clicked="Analizar_Click"
                                            IsEnabled="{Binding PuedeAnalizar}"
                                            CommandParameter="{Binding Id}" />
                                    <Button Text="Crear cuestionario" Style="{StaticResource GhostButton}"
                                            HeightRequest="38" Clicked="CrearCuestionario_Click"
                                            IsVisible="{Binding Listo}"
                                            CommandParameter="{Binding Id}" />
                                    <Button Text="🗑  Eliminar" Style="{StaticResource GhostButton}"
                                            HeightRequest="38" TextColor="{StaticResource Pink}"
                                            Clicked="Eliminar_Click" CommandParameter="{Binding Id}" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
