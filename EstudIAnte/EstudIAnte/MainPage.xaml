<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:EstudIAnte"
             xmlns:controls="clr-namespace:EstudIAnte.Controls"
             x:Class="EstudIAnte.MainPage"
             Title="EstudIAnte"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Bg}">
    <Grid x:Name="MainLayout" ColumnDefinitions="220,*" Padding="0">

        <!-- ========== BARRA LATERAL ========== -->
        <Grid x:Name="NavigationPanel" Grid.Column="0" BackgroundColor="{StaticResource Sidebar}"
              RowDefinitions="Auto,*,Auto" Padding="14">
            <HorizontalStackLayout x:Name="BrandHeader" Grid.Row="0" Spacing="10" Margin="8,8,0,26">
                <Label Text="🎓" FontSize="28" VerticalOptions="Center" />
                <Label FontSize="21" FontAttributes="Bold" TextColor="{StaticResource TextMain}" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Estud" />
                            <Span Text="IA" TextColor="{StaticResource Cyan}" />
                            <Span Text="nte" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>

            <ScrollView x:Name="NavigationScroll" Grid.Row="1" Orientation="Vertical"
                        HorizontalScrollBarVisibility="Never" VerticalScrollBarVisibility="Never">
                <FlexLayout x:Name="NavItems" Direction="Column" Wrap="NoWrap">
                <RadioButton x:Name="N1" Style="{StaticResource NavItem}" GroupName="nav" IsChecked="True"
                             Content="🏠   Inicio" CheckedChanged="OnNavChanged" />
                <RadioButton x:Name="N2" Style="{StaticResource NavItem}" GroupName="nav"
                             Content="💬   Chat Temático" CheckedChanged="OnNavChanged" />
                <RadioButton x:Name="N3" Style="{StaticResource NavItem}" GroupName="nav"
                             Content="📋   Cuestionarios" CheckedChanged="OnNavChanged" />
                <RadioButton x:Name="N5" Style="{StaticResource NavItem}" GroupName="nav"
                             Content="🔀   Diagramas" CheckedChanged="OnNavChanged" />
                <RadioButton x:Name="N4" Style="{StaticResource NavItem}" GroupName="nav"
                             Content="📁   Documentos" CheckedChanged="OnNavChanged" />
                <RadioButton x:Name="N6" Style="{StaticResource NavItem}" GroupName="nav"
                             Content="🗂   Mis Archivos" CheckedChanged="OnNavChanged" />
                <RadioButton x:Name="N8" Style="{StaticResource NavItem}" GroupName="nav" IsVisible="False"
                             Content="🛡   Panel Admin" CheckedChanged="OnNavChanged" />
                <RadioButton x:Name="N7" Style="{StaticResource NavItem}" GroupName="nav"
                             Content="⚙   Configuración" CheckedChanged="OnNavChanged" />
                </FlexLayout>
            </ScrollView>

            <Border x:Name="UserCard" Grid.Row="2" Style="{StaticResource Card}" Padding="10" StrokeShape="RoundRectangle 14">
                <HorizontalStackLayout Spacing="10">
                    <Border WidthRequest="38" HeightRequest="38" StrokeThickness="0"
                            Background="{StaticResource BrandGradient}" StrokeShape="RoundRectangle 19">
                        <Label x:Name="AvatarInicial" Text="?" FontAttributes="Bold" TextColor="{StaticResource OnCyan}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                        <Label x:Name="NombreUsuario" Text="Invitado" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        <Label x:Name="RolUsuario" Text="Estudiante" FontSize="11" TextColor="{StaticResource TextMuted}" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- ========== CONTENIDO ========== -->
        <Grid x:Name="ContentPanel" Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Barra superior: buscador + avatar -->
            <Grid x:Name="TopBar" Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Padding="28,22,28,14">
                <controls:PulsarButton x:Name="BtnMenu" Text="☰" FontSize="21"
                        Style="{StaticResource GhostButton}" WidthRequest="44" HeightRequest="44"
                        IsVisible="False" Clicked="Menu_Tapped" />
                <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,0" HeightRequest="46"
                        StrokeShape="RoundRectangle 23" HorizontalOptions="Fill"
                        MaximumWidthRequest="620">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Label Text="🔍" FontSize="15" VerticalOptions="Center" />
                        <Entry x:Name="BuscadorGlobal" Grid.Column="1" Placeholder="Buscar temas, documentos o preguntas..."
                               BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                               PlaceholderColor="{StaticResource TextMuted}" VerticalOptions="Center"
                               TextChanged="BuscadorGlobal_TextChanged" />
                    </Grid>
                </Border>
                <Border Grid.Column="2" WidthRequest="42" HeightRequest="42" StrokeThickness="2"
                        Stroke="{StaticResource Violet}" StrokeShape="RoundRectangle 21"
                        BackgroundColor="{StaticResource SurfaceAlt}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="Avatar_Tapped" />
                    </Border.GestureRecognizers>
                    <Label x:Name="AvatarSuperior" Text="?" FontAttributes="Bold" TextColor="{StaticResource TextMain}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <Grid Grid.Row="1">
                <views:InicioView x:Name="VInicio" IsVisible="True" />
                <views:ChatView x:Name="VChat" IsVisible="False" />
                <views:CuestionarioView x:Name="VQuiz" IsVisible="False" />
                <views:DiagramasView x:Name="VDiag" IsVisible="False" />
                <views:DocumentosView x:Name="VDocs" IsVisible="False" />
                <views:MisArchivosView x:Name="VArchivos" IsVisible="False" />
                <views:ConfiguracionView x:Name="VConfig" IsVisible="False" />
                <views:AdminView x:Name="VAdmin" IsVisible="False" />
            </Grid>
        </Grid>
        <BoxView x:Name="MenuBackdrop" Grid.ColumnSpan="2" Grid.RowSpan="2"
                 IsVisible="False" BackgroundColor="#99040A20" ZIndex="1">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="MenuBackdrop_Tapped" />
            </BoxView.GestureRecognizers>
        </BoxView>
    </Grid>
</ContentPage>
