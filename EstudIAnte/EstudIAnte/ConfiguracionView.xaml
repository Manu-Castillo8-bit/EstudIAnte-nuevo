<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:controls="clr-namespace:EstudIAnte.Controls"
             x:Class="EstudIAnte.ConfiguracionView">
    <ScrollView>
        <VerticalStackLayout Padding="{OnIdiom Phone='14,8,14,20', Tablet='20,8,20,20', Default='28,8,28,28'}"
                             Spacing="16" MaximumWidthRequest="760"
                             HorizontalOptions="Fill">

            <!-- Encabezado -->
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                <Border WidthRequest="54" HeightRequest="54" BackgroundColor="#312E81"
                        Stroke="{StaticResource Violet}" StrokeThickness="1" StrokeShape="RoundRectangle 16">
                    <Label Text="⚙" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="Configuración" Style="{StaticResource PageTitle}" />
                    <Label Text="Cuenta y sincronización" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </Grid>

            <!-- Cuenta -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Cuenta" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Text="👤" FontSize="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Usuario" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        <Label x:Name="LblUsuario" Grid.Column="2" Text="—" FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" VerticalOptions="Center" />
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Label Text="🎓" FontSize="20" VerticalOptions="Center" />
                        <Label Grid.Column="1" Text="Rol" Style="{StaticResource Muted}" VerticalOptions="Center" />
                        <Label x:Name="LblRol" Grid.Column="2" Text="—" FontAttributes="Bold"
                               TextColor="{StaticResource TextMain}" VerticalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Sincronización -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sincronización" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                    <Label x:Name="LblEstadoNube" Text="Comprobando conexión..."
                           FontSize="13" TextColor="{StaticResource TextMuted}" />
                    <HorizontalStackLayout Spacing="10">
                        <controls:PulsarButton x:Name="BtnSincronizar" Text="🔄  Sincronizar ahora"
                                Style="{StaticResource PrimaryButton}" Clicked="Sincronizar_Click" />
                        <controls:PulsarButton Text="🔎  Probar conexión" Style="{StaticResource GhostButton}"
                                Clicked="ProbarConexion_Click" />
                    </HorizontalStackLayout>
                    <Label x:Name="LblResultadoSync" Text="" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    <Label Text="Al sincronizar, todo lo creado sin conexión se sube a la nube y se descarga lo que hayas hecho en otros dispositivos con la misma cuenta."
                           FontSize="12" TextColor="{StaticResource TextMuted}" />
                </VerticalStackLayout>
            </Border>

            <!-- Sesión -->
            <Border Style="{StaticResource Card}" Padding="20">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Sesión" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                    <controls:PulsarButton Text="🚪  Cerrar sesión" Style="{StaticResource GhostButton}"
                            TextColor="{StaticResource Pink}" Clicked="CerrarSesion_Click" />
                </VerticalStackLayout>
            </Border>

            <!-- Acerca de -->
            <Border BackgroundColor="#2A2412" Stroke="{StaticResource Amber}" StrokeThickness="1"
                    StrokeShape="RoundRectangle 16" Padding="16">
                <HorizontalStackLayout Spacing="10">
                    <Label Text="💡" FontSize="22" VerticalOptions="Start" />
                    <VerticalStackLayout Spacing="2">
                        <Label Text="EstudIAnte" FontAttributes="Bold" TextColor="{StaticResource Amber}" />
                        <Label Text="Tu asistente educativo inteligente · v1.0" FontSize="12" TextColor="#FDE68A" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
