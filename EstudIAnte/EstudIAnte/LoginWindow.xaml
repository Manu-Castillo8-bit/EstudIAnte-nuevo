<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     xmlns:controls="clr-namespace:EstudIAnte.Controls"
             x:Class="EstudIAnte.LoginWindow"
             Title="Login"
             BackgroundColor="{StaticResource Bg}">
    <Grid x:Name="LoginLayout" Background="{StaticResource LoginBg}"
          ColumnDefinitions="1.15*,*" RowDefinitions="*,Auto,*" Padding="40">

        <!-- ========== PANEL DE MARCA ========== -->
        <VerticalStackLayout x:Name="BrandPanel" Grid.Column="0" Grid.Row="1" Spacing="26" VerticalOptions="Center"
                             Margin="30,0,30,0">
            <HorizontalStackLayout Spacing="14">
                <Label Text="🎓" FontSize="52" VerticalOptions="Center" />
                <VerticalStackLayout VerticalOptions="Center">
                    <Label FontSize="34" FontAttributes="Bold" TextColor="{StaticResource TextMain}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Estud" />
                                <Span Text="IA" TextColor="{StaticResource Cyan}" />
                                <Span Text="nte" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label Text="Tu asistente educativo inteligente" Style="{StaticResource Muted}" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <Label FontSize="40" FontAttributes="Bold" TextColor="{StaticResource TextMain}" LineHeight="1.15">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Aprende mejor," />
                        <Span Text="&#10;con " />
                        <Span Text="inteligencia" TextColor="{StaticResource Pink}" />
                    </FormattedString>
                </Label.FormattedText>
            </Label>

            <VerticalStackLayout Spacing="14">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#3322D3EE" StrokeThickness="1"
                            Stroke="{StaticResource Cyan}" StrokeShape="RoundRectangle 12">
                        <Label Text="🎓" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Tutorías personalizadas" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        <Label Text="Aprende a tu ritmo" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#338B5CF6" StrokeThickness="1"
                            Stroke="{StaticResource Violet}" StrokeShape="RoundRectangle 12">
                        <Label Text="📋" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Cuestionarios interactivos" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        <Label Text="Evalúa tus conocimientos" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#33EC4899" StrokeThickness="1"
                            Stroke="{StaticResource Pink}" StrokeShape="RoundRectangle 12">
                        <Label Text="🔀" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Diagramas y esquemas" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        <Label Text="Visualiza conceptos fácilmente" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                    <Border WidthRequest="46" HeightRequest="46" BackgroundColor="#3310B981" StrokeThickness="1"
                            Stroke="{StaticResource Emerald}" StrokeShape="RoundRectangle 12">
                        <Label Text="📁" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                        <Label Text="Análisis de documentos" FontAttributes="Bold" TextColor="{StaticResource TextMain}" />
                        <Label Text="Obtén respuestas desde tus archivos" Style="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>

        <!-- ========== TARJETA DE LOGIN ========== -->
        <Border x:Name="LoginCard" Grid.Column="1" Grid.Row="1" Style="{StaticResource Card}" BackgroundColor="#CC101840"
                Padding="36" WidthRequest="420" MaximumWidthRequest="460"
                StrokeShape="RoundRectangle 24"
                HorizontalOptions="Center" VerticalOptions="Center">
            <ScrollView x:Name="LoginScroll">
            <Grid x:Name="LoginContentGrid" RowDefinitions="*,Auto,*">
            <VerticalStackLayout x:Name="Root" Grid.Row="1" Spacing="14">
                <!-- ========== PANEL DE LOGIN ========== -->
                <VerticalStackLayout x:Name="PanelLogin" Spacing="14">
                    <Label Text="Iniciar sesión" FontSize="30" FontAttributes="Bold"
                           TextColor="{StaticResource Cyan}" HorizontalOptions="Center" />
                    <Label Text="Ingresa a tu cuenta para continuar" Style="{StaticResource Muted}"
                           HorizontalOptions="Center" Margin="0,0,0,10" />

                    <Label Text="Usuario o correo" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    <Border Style="{StaticResource Card}" Padding="14,0" HeightRequest="50"
                            StrokeShape="RoundRectangle 12" BackgroundColor="#0B1233">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="✉" FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            <Entry x:Name="Usuario" Grid.Column="1" Placeholder="ejemplo@correo.com"
                                   BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                                   PlaceholderColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="Contraseña" FontSize="12" TextColor="{StaticResource TextMuted}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Card}" Padding="14,0" HeightRequest="50"
                            StrokeShape="RoundRectangle 12" BackgroundColor="#0B1233">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Text="🔒" FontSize="16" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            <Entry x:Name="Clave" Grid.Column="1" Placeholder="Ingresa tu contraseña" IsPassword="True"
                                   BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                                   PlaceholderColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            <controls:PulsarButton Grid.Column="2" Text="👁" BackgroundColor="Transparent" Padding="0"
                                    WidthRequest="36" HeightRequest="36" Clicked="Ver_Click" />
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,6">
                        <CheckBox x:Name="Recordar" Color="{StaticResource Cyan}" IsChecked="True" />
                        <Label Grid.Column="1" Text="Recordar sesión" FontSize="13"
                               TextColor="{StaticResource TextMain}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Text="¿Olvidaste tu contraseña?" FontSize="12"
                               TextColor="{StaticResource Cyan}" VerticalOptions="Center">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Tapped="Olvidaste_Tapped" />
                            </Label.GestureRecognizers>
                        </Label>
                    </Grid>

                    <Grid>
                        <controls:PulsarButton x:Name="BtnLogin" Text="➜   Iniciar sesión" Style="{StaticResource PrimaryButton}"
                                Clicked="Login_Click" HeightRequest="52" TextoCarga="" />
                        <ActivityIndicator x:Name="LoginSpinner" IsRunning="False" IsVisible="False"
                                InputTransparent="True" Color="{StaticResource OnCyan}"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>

                    <Label HorizontalOptions="Center" FontSize="13" Margin="0,8,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="¿No tienes una cuenta?  " TextColor="{StaticResource TextMuted}" />
                                <Span Text="Regístrate aquí" TextColor="{StaticResource Cyan}" FontAttributes="Bold">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="IrRegistro_Tapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <!-- ========== PANEL DE REGISTRO ========== -->
                <VerticalStackLayout x:Name="PanelRegistro" Spacing="14" IsVisible="False">
                    <Label Text="Crear cuenta" FontSize="30" FontAttributes="Bold"
                           TextColor="{StaticResource Cyan}" HorizontalOptions="Center" />
                    <Label Text="Regístrate para guardar tu progreso en la nube" Style="{StaticResource Muted}"
                           HorizontalOptions="Center" Margin="0,0,0,10" />

                    <Label Text="Nombre de usuario" FontSize="12" TextColor="{StaticResource TextMuted}" />
                    <Border Style="{StaticResource Card}" Padding="14,0" HeightRequest="50"
                            StrokeShape="RoundRectangle 12" BackgroundColor="#0B1233">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="👤" FontSize="16" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            <Entry x:Name="RegUsuario" Grid.Column="1" Placeholder="Tu nombre de usuario"
                                   BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                                   PlaceholderColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="Correo (opcional)" FontSize="12" TextColor="{StaticResource TextMuted}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Card}" Padding="14,0" HeightRequest="50"
                            StrokeShape="RoundRectangle 12" BackgroundColor="#0B1233">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="✉" FontSize="18" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            <Entry x:Name="RegEmail" Grid.Column="1" Placeholder="ejemplo@correo.com"
                                   Keyboard="Email" BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                                   PlaceholderColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="Contraseña (mínimo 4 caracteres)" FontSize="12" TextColor="{StaticResource TextMuted}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Card}" Padding="14,0" HeightRequest="50"
                            StrokeShape="RoundRectangle 12" BackgroundColor="#0B1233">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="🔒" FontSize="16" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            <Entry x:Name="RegClave" Grid.Column="1" Placeholder="Crea una contraseña" IsPassword="True"
                                   BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                                   PlaceholderColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Label Text="Confirmar contraseña" FontSize="12" TextColor="{StaticResource TextMuted}" Margin="0,6,0,0" />
                    <Border Style="{StaticResource Card}" Padding="14,0" HeightRequest="50"
                            StrokeShape="RoundRectangle 12" BackgroundColor="#0B1233">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                            <Label Text="🔒" FontSize="16" TextColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                            <Entry x:Name="RegClave2" Grid.Column="1" Placeholder="Repite la contraseña" IsPassword="True"
                                   BackgroundColor="Transparent" TextColor="{StaticResource TextMain}"
                                   PlaceholderColor="{StaticResource TextMuted}" VerticalOptions="Center" />
                        </Grid>
                    </Border>

                    <Grid Margin="0,10,0,0">
                        <controls:PulsarButton x:Name="BtnRegistrar" Text="✚   Crear cuenta" Style="{StaticResource PrimaryButton}"
                                Clicked="Registrar_Click" HeightRequest="52" TextoCarga="" />
                        <ActivityIndicator x:Name="RegisterSpinner" IsRunning="False" IsVisible="False"
                                InputTransparent="True" Color="{StaticResource OnCyan}"
                                HorizontalOptions="Center" VerticalOptions="Center" />
                    </Grid>

                    <Label HorizontalOptions="Center" FontSize="13" Margin="0,8,0,0">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="¿Ya tienes cuenta?  " TextColor="{StaticResource TextMuted}" />
                                <Span Text="Inicia sesión" TextColor="{StaticResource Cyan}" FontAttributes="Bold">
                                    <Span.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="VolverLogin_Tapped" />
                                    </Span.GestureRecognizers>
                                </Span>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>

                <Label x:Name="EstadoSupabase" Text="Comprobando conexión con Supabase..."
                       FontSize="12" HorizontalOptions="Center" HorizontalTextAlignment="Center"
                       TextColor="{StaticResource TextMuted}" Margin="0,10,0,0" />
            </VerticalStackLayout>
            </Grid>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
