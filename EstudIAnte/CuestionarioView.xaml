<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EstudIAnte.CuestionarioView">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="14">
            <Label Text="Cuestionarios" FontSize="28" FontAttributes="Bold" TextColor="#E8ECFF" />

            <Border BackgroundColor="#131B3F" Stroke="#1E2A5A" StrokeThickness="1"
                    StrokeShape="RoundRectangle 12" Padding="18">
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. ¿En qué año inició la Revolución Industrial?"
                           FontAttributes="Bold" TextColor="#E8ECFF" />
                    <RadioButton Content="1760" GroupName="q1" TextColor="#E8ECFF" />
                    <RadioButton Content="1492" GroupName="q1" TextColor="#E8ECFF" />
                    <RadioButton Content="1900" GroupName="q1" TextColor="#E8ECFF" />
                </VerticalStackLayout>
            </Border>

            <Button Text="Siguiente" BackgroundColor="#22D3EE" TextColor="#0B1026" HorizontalOptions="Start" />
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
